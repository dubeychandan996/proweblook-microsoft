    "paths": {
        "/verify-lead": {
            "post": {
                "operationId": "VerifyLeadMultiSignal",
                "summary": "Verify lead and calculate fraud trust score",
                "description": "Runs parallel multi-signal verification across phone carrier, WhatsApp, email deliverability, Caller ID, corporate DNSBL, and Edge GeoIP to return a composite 0 to 100 trust score and risk level.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "x-ms-summary": "Lead Verification Request",
                        "description": "Lead contact identifiers and optional signal toggles to evaluate.",
                        "schema": {
                            "$ref": "#/definitions/VerifyLeadRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Composite lead trust score, risk classification, and multi-signal verification details.",
                        "schema": {
                            "$ref": "#/definitions/VerifyLeadResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid input parameter format or missing required identifier.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid ProWebLook API key.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "402": {
                        "description": "Insufficient ProWebLook credit balance for the requested verification signal.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "default": {
                        "description": "Unexpected upstream verification error.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/validate-phone": {
            "post": {
                "operationId": "ValidatePhone",
                "summary": "Validate phone number and line type",
                "description": "Validates an international or national phone number and returns carrier name, line type (Mobile, VoIP, or Landline), E.164 formatting, and geographic region.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "x-ms-summary": "Phone Validation Request",
                        "description": "Phone number and optional ISO country hint to validate.",
                        "schema": {
                            "$ref": "#/definitions/PhoneLookupRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Validated phone carrier, line type, and formatting metadata.",
                        "schema": {
                            "$ref": "#/definitions/PhoneValidationResult"
                        }
                    },
                    "400": {
                        "description": "Invalid input parameter format or missing required identifier.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid ProWebLook API key.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "402": {
                        "description": "Insufficient ProWebLook credit balance for the requested verification signal.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "default": {
                        "description": "Unexpected upstream verification error.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/check-whatsapp": {
            "post": {
                "operationId": "CheckWhatsApp",
                "summary": "Check WhatsApp registration status",
                "description": "Silently checks whether a phone number is registered on WhatsApp Personal or WhatsApp Business without sending any message or notification.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "x-ms-summary": "WhatsApp Check Request",
                        "description": "Phone number and optional ISO country code hint for silent WhatsApp verification.",
                        "schema": {
                            "$ref": "#/definitions/PhoneLookupRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Silent WhatsApp registration and Business account status.",
                        "schema": {
                            "$ref": "#/definitions/WhatsAppCheckResult"
                        }
                    },
                    "400": {
                        "description": "Invalid input parameter format or missing required identifier.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid ProWebLook API key.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "402": {
                        "description": "Insufficient ProWebLook credit balance for the requested verification signal.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "default": {
                        "description": "Unexpected upstream verification error.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/verify-email": {
            "post": {
                "operationId": "VerifyEmail",
                "summary": "Verify email deliverability and disposable status",
                "description": "Verifies email syntax, domain MX records, mailbox existence, corporate vs. webmail type, and 10-minute disposable temp-mail domains.",
                "x-ms-visibility": "important",
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "x-ms-summary": "Email Verification Request",
                        "description": "Email address to check for deliverability and disposable domain risk.",
                        "schema": {
                            "$ref": "#/definitions/EmailVerifyRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Email deliverability verdict and domain classification.",
                        "schema": {
                            "$ref": "#/definitions/EmailVerificationResult"
                        }
                    },
                    "400": {
                        "description": "Invalid input parameter format or missing required identifier.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Missing or invalid ProWebLook API key.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "402": {
                        "description": "Insufficient ProWebLook credit balance for the requested verification signal.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    },
                    "default": {
                        "description": "Unexpected upstream verification error.",
                        "schema": {
                            "$ref": "#/definitions/ErrorResponse"
                        }
                    }
                }
            }
        },
        "/lookup-caller-id": {
            "post": {
                "operationId": "LookupCallerId",
                "summary": "Look up Caller ID subscriber name",
                "description": "Retrieves the registered CNAM Caller ID subscriber name and compares it against an optional lead or company name to detect spoofed identities.",
