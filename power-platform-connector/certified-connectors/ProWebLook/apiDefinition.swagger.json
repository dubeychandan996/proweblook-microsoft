                    "description": "Indicates whether the API call succeeded."
                },
                "code": {
                    "type": "string",
                    "x-ms-summary": "Error Code",
                    "description": "Machine-readable error identifier such as invalid_input or insufficient_credit."
                },
                "error": {
                    "type": "string",
                    "x-ms-summary": "Error Message",
                    "description": "Human-readable explanation of why the request failed."
                }
            }
        },
        "PhoneLookupRequest": {
            "type": "object",
            "required": [
                "phoneNumber"
            ],
            "description": "Parameters for validating a phone number or checking WhatsApp registration.",
            "properties": {
                "phoneNumber": {
                    "type": "string",
                    "x-ms-summary": "Phone Number",
                    "description": "Phone number in E.164 format (+14155552671) or national digits."
                },
                "countryCode": {
                    "type": "string",
                    "x-ms-summary": "Country Code Hint",
                    "description": "Optional 2-letter ISO 3166-1 alpha-2 country hint such as US, IN, or GB."
