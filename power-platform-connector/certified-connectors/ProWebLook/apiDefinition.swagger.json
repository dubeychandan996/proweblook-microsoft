{
    "swagger": "2.0",
    "info": {
        "title": "ProWebLook",
        "description": "Verify phone numbers, carrier and VoIP line types, silent WhatsApp registration, email deliverability, Caller ID (CNAM), DNSBL domain reputation, Edge GeoIP, and composite 0-100 lead and COD fraud trust scores across Power Automate, Logic Apps, and Microsoft Copilot Studio.",
        "version": "1.0.0",
        "contact": {
            "name": "ProWebLook Support",
            "url": "https://excel.proweblook.com/support",
            "email": "support@proweblook.com"
        }
    },
    "x-ms-connector-metadata": [
        {
            "propertyName": "Website",
            "propertyValue": "https://proweblook.com"
        },
        {
            "propertyName": "Privacy policy",
            "propertyValue": "https://excel.proweblook.com/privacy"
        },
        {
            "propertyName": "Categories",
            "propertyValue": "Data;Security"
        }
    ],
    "host": "m365.proweblook.com",
    "basePath": "/api/connector/v1",
    "schemes": [
        "https"
    ],
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "securityDefinitions": {
        "api_key": {
            "type": "apiKey",
            "in": "header",
            "name": "X-API-Key",
            "description": "Your ProWebLook API key from https://proweblook.com/user/api_key."
        }
    },
    "security": [
        {
            "api_key": []
        }
