                    "description": "Optional customer or lead name to compare against the registered Caller ID."
                },
                "companyName": {
                    "type": "string",
                    "x-ms-summary": "Company Name",
                    "description": "Optional business or organization name to compare against Caller ID."
                }
            }
        },
        "BlacklistCheckRequest": {
            "type": "object",
            "required": [
                "target"
            ],
            "description": "Parameters for screening a domain or IP against DNSBL blocklists.",
            "properties": {
                "target": {
                    "type": "string",
                    "x-ms-summary": "Domain or IP",
