                        }
                    }
                }
            }
        },
        "/lookup-ip-geo": {
            "post": {
                "operationId": "LookupIpGeo",
                "summary": "Look up IP geolocation and VPN status",
                "description": "Resolves IPv4 or IPv6 geolocation, ISP, ASN, datacenter/VPN/proxy flags, and optional billing country mismatch.",
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
