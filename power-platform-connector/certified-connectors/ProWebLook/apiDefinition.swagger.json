        "/balances": {
            "get": {
                "operationId": "GetAccountBalances",
                "summary": "Get ProWebLook credit balances",
                "description": "Returns current credit balances across Phone, WhatsApp, Email, Caller ID, Blacklist, and monthly Edge GeoIP pools for the authenticated ProWebLook account.",
                "x-ms-visibility": "important",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "Current ProWebLook product credit balances.",
