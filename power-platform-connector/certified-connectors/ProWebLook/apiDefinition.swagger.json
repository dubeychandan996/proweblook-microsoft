                        }
                    }
                }
            }
        },
        "/check-blacklist": {
            "post": {
                "operationId": "CheckBlacklist",
                "summary": "Check domain or IP against DNSBL blocklists",
                "description": "Screens a corporate domain name or public IP address against more than 50 real-time DNSBL spam, phishing, and malware blocklists.",
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "x-ms-summary": "Blacklist Check Request",
